  const rawConfig = 键值配置;
  键值配置 = 获取有效配置快照(env);
  更新配置值();
  当前工作器地区 ||= 'CF';
  键值配置 = rawConfig;
  const prefix = '/' + 认证令牌;
  const customPrefix = 自定义路径 ? '/' + 自定义路径.replace(/^\/+|\/+$/g, '') : '';
  const matches = suffix => url.pathname === prefix + suffix || (customPrefix && url.pathname === customPrefix + suffix);

  if (matches('/api/config')) {
    if (request.method === 'GET') return jsonResponse({ ...获取有效配置快照(env), kvEnabled: !!键值存储 });
    if (request.method !== 'POST') return jsonResponse({ error: '只支持 GET 和 POST' }, 405);
    if (!键值存储) return jsonResponse({ success: false, message: 'KV 未绑定，无法保存配置' }, 503);
    let changes;
    try {
      const text = await request.text();
      if (text.length > 65536) return jsonResponse({ error: '配置过大' }, 413);
      changes = JSON.parse(text);
      if (!changes || Array.isArray(changes) || typeof changes !== 'object') throw new Error();
      for (const [key, value] of Object.entries(changes)) {
        if (!Object.hasOwn(配置默认值, key) || (value !== null && !['string', 'boolean', 'number'].includes(typeof value))) throw new Error();
        if (typeof value === 'string' && value.length > 16384) throw new Error();
        if (value === '' || value === null) delete 键值配置[key];
        else 键值配置[key] = value;
      }
    } catch {
      return jsonResponse({ success: false, message: '配置格式无效' }, 400);
    }
    await 保存键值配置();
    configCache.delete(键值存储);
    return jsonResponse({ success: true, message: '配置已保存', config: 获取有效配置快照(env) });
  }
  if (matches('/api/preferred-ips')) {
    const response = await 处理优选地址列表接口(request);
    if (request.method !== 'GET' && response.ok && 键值存储) configCache.delete(键值存储);
    return withCors(response);
  }
  if (matches('/region') && request.method === 'GET') {
    return jsonResponse({ region: 当前工作器地区, detectionMethod: 手动工作器地区 ? '手动指定地区' : 回退地址 ? '自定义 ProxyIP 模式' : '官方直连', manualRegion: 手动工作器地区, ci: 回退地址, timestamp: new Date().toISOString() });
  }
  if (matches('/test-api') && request.method === 'GET') return jsonResponse({ detectedRegion: 当前工作器地区, message: 'API 正常运行' });
  if (request.headers.get('Upgrade')?.toLowerCase() === atob('d2Vic29ja2V0')) return 处理网页套接字请求(request);
  if (request.method === 'POST' && 启用扩展传输 && (matches('') || (传输路径 && url.pathname === '/' + 传输路径.replace(/^\/+|\/+$/g, '')))) {
    const { 头: paddingHeader, 键: paddingKey } = 获取叉HTTP填充标识(认证令牌);
    if (!校验叉HTTP填充(request, paddingHeader, paddingKey)) return new Response('Bad Request', { status: 400 });
    const result = await 处理扩展超文本值(request);
    if (!result) return new Response('Internal Server Error', { status: 502 });
    ctx.waitUntil(result.closed.catch(() => {}));
    const padding = new URL('https://x.invalid/');
    padding.searchParams.set(paddingKey, 生成叉HTTP填充串(100 + Math.floor(Math.random() * 901)));
    return new Response(result.readable, { headers: { 'X-Accel-Buffering': 'no', 'Cache-Control': 'no-store', 'Content-Type': 'application/grpc', [paddingHeader]: padding.toString() } });
  }
